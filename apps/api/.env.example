# RFID Demo. Copia este archivo como .env y completa los valores localmente.
# Nunca subas .env al repositorio.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/rfid_demo?schema=public
# Base autorizada: db:check, db:migrate y db:seed se detienen si no coincide.
RFID_DEMO_DATABASE=rfid_demo
PORT=3001
HOST=0.0.0.0
# Secreto aleatorio de al menos 32 caracteres (node scripts/Configure-Jwt.mjs).
JWT_SECRET=
# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5174
